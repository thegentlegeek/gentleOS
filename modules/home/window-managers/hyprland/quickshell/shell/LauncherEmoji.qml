pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick
import "fuzzy.js" as Fuzzy

// Emoji mode: emoji, Nerd Font glyphs and symbols from Settings.emojiData
// (generated by ../emoji.py). Enter copies the character.
Singleton {
    id: root

    property var data: ({ emoji: [], nerd: [], symbols: [] })
    // Character -> entry, for recent items.
    property var byChar: ({})

    readonly property var tabs: [["emoji", "Emoji"], ["nerd", "Nerd Font"], ["symbols", "Symbols"]]

    FileView {
        path: Settings.emojiData
        onLoaded: {
            const data = JSON.parse(text());
            const byChar = {};
            for (const tab of ["emoji", "nerd", "symbols"]) {
                for (const e of data[tab]) {
                    e.tab = tab;
                    byChar[e.c] = e;
                }
            }
            root.data = data;
            root.byChar = byChar;
        }
    }

    // "U+1F525", skipping the emoji presentation selector.
    function codepoints(c) {
        const out = [];
        for (let i = 0; i < c.length; i++) {
            const cp = c.codePointAt(i);
            if (cp > 0xffff)
                i++;
            if (cp !== 0xfe0f)
                out.push("U+" + cp.toString(16).toUpperCase());
        }
        return out.join(" ");
    }

    function item(e, section) {
        return {
            key: "emoji:" + e.c,
            kind: "emoji",
            section: section,
            char: e.c,
            title: e.n,
            detail: [e.k ? e.k.split(" ").slice(0, 6).join(", ") : "", codepoints(e.c)].filter(t => t).join(" · "),
            glyph: e.c,
            run: () => Quickshell.execDetached([Settings.wlCopy, e.c])
        };
    }

    // Flat items, each tagged with the section it's shown under: recent use
    // and then every group with no query, else the best matches.
    function rows(tab, query) {
        const list = data[tab] ?? [];
        if (query) {
            // Substring matches only: scattered letters across thousands of
            // names match nearly everything.
            const matches = [];
            for (const e of list) {
                const m = Fuzzy.best(query, [[e.n, 1, true], [e.k ?? "", 0.7, true]]);
                if (m)
                    matches.push({ e, score: m.score });
            }
            return matches.sort((a, b) => b.score - a.score).slice(0, 240).map(x => item(x.e, "Results"));
        }
        const recent = LauncherState.recentKeys("emoji:")
            .map(k => byChar[k.slice(6)]).filter(e => e && e.tab === tab).slice(0, 12)
            .map(e => item(e, "Recent"));
        return recent.concat(list.map(e => item(e, e.g ?? "All")));
    }

    // For recent items: "emoji:<char>" -> item.
    function byKey(key) {
        const e = byChar[key.slice(6)];
        return e ? item(e, "") : null;
    }
}
