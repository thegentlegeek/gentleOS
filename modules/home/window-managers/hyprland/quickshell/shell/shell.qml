//@ pragma UseQApplication

// gentleOS desktop shell. Colors, fonts and commands come from Theme.qml.json
// and Settings.qml.json, generated by ../default.nix (Stylix).

import Quickshell
import Quickshell.Io
import QtQuick

ShellRoot {
    Variants {
        model: Quickshell.screens

        delegate: Bar {
            required property ShellScreen modelData

            screen: modelData
        }
    }

    NotificationPopups {}
    NotificationCenter {}
    QuickSettings {}
    SessionMenu {}
    Calendar {}
    Launcher {}
    Pinentry {}

    // Keybinds in hyprland.lua: quickshell ipc -c gentle call shell <function>
    IpcHandler {
        target: "shell"

        function toggleQuickSettings(): void {
            ShellState.toggle("quickSettings");
        }

        function toggleNotifications(): void {
            ShellState.toggle("notifications");
        }

        function toggleSession(): void {
            ShellState.toggle("session");
        }

        function toggleCaffeine(): void {
            ShellState.caffeine = !ShellState.caffeine;
        }

        function toggleCalendar(): void {
            ShellState.toggle("calendar");
        }

        function toggleLauncher(): void {
            LauncherState.toggle();
        }

        // mode: "all" or a LauncherState.modes mode ("clipboard", "keybinds"…).
        function openLauncher(mode: string): void {
            LauncherState.show(mode);
        }

        function closeLauncher(): void {
            LauncherState.close();
        }

        function toggleDnd(): void {
            Notifs.dnd = !Notifs.dnd;
        }

        function clearNotifications(): void {
            Notifs.clearAll();
        }
    }
}
